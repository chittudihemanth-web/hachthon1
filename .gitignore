# ─────────────────────────────────────────────────────────────
# PulseFlow AI — Comprehensive .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
out/
dist-ssr/
*.tsbuildinfo

# Environment Variables, Secrets & API Keys
# (Never commit actual API keys or Supabase secrets!)
.env
.env.*
*.env
env
**/env
!.env.example
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.temp/
**/.temp/

# Logs & Debug Telemetry
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Configs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# Caches & Temporary Files
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.oxlintcache
.turbo/
tmp/
temp/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Local AI / IDE specific
.gemini/
.agents/
.system_generated/
